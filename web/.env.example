# Frontend build-time configuration (Vite). Only PUBLIC values belong here —
# anything prefixed VITE_ is embedded in the browser bundle. Never put a service
# role key, database URL, or OpenAI key in a VITE_ variable.

# Supabase project URL and the publishable/anon key (both public-safe).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# The API is served same-origin at /api in production; no base URL is needed.
