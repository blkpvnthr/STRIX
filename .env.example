# STRIX environment configuration (example — copy to .env and fill in).
# .env is gitignored; never commit real secrets.

# --- OpenAI research agent -------------------------------------------------
# The API key. STRIX accepts either variable name; OPEN_AI_API_KEY is the
# project's historical name and OPENAI_API_KEY is what the OpenAI SDK expects.
OPENAI_API_KEY=sk-your-openai-key-here
# OPEN_AI_API_KEY=sk-your-openai-key-here

# Provider + model. gpt-6-luna is the default because it is the cheapest of the
# permitted models (gpt-6-luna, gpt-6.1-terra, gpt-6.1-sol, gpt-6-astra).
STRIX_LLM_PROVIDER=openai
STRIX_LLM_MODEL=gpt-6-luna
STRIX_LLM_REASONING_EFFORT=low
STRIX_LLM_MAX_OUTPUT_TOKENS=4096
STRIX_LLM_REQUEST_TIMEOUT_SECONDS=60
STRIX_LLM_MAX_RETRIES=2

# Per-run research budget (all enforced in code).
STRIX_AGENT_MAX_MODEL_CALLS=8
STRIX_AGENT_MAX_TOOL_CALLS=16
STRIX_AGENT_MAX_RESEARCH_SECONDS=120
STRIX_AGENT_MAX_INPUT_TOKENS=100000
STRIX_AGENT_MAX_TOTAL_OUTPUT_TOKENS=16000
STRIX_AGENT_MAX_COST_USD=0.05

STRIX_AGENT_ALLOW_MODEL_ESCALATION=false
STRIX_AGENT_REQUIRE_VERIFIED_CLAIMS=true
STRIX_AGENT_REQUIRE_CITATIONS=true
STRIX_OPENAI_WEB_SEARCH_ENABLED=true

# --- Optional market-data provider (Alpaca) --------------------------------
# ALPACA_API_KEY_ID=your-alpaca-key-id
# ALPACA_API_SECRET_KEY=your-alpaca-secret

# --- Existing STRIX service settings ---------------------------------------
# STRIX_STATE_DIR=research_runs
