# STRIX environment configuration (example — copy to .env and fill in).
# .env is gitignored; never commit real secrets. On Vercel, set these as
# server-side Environment Variables (never VITE_-prefixed) — see
# docs/deployment/vercel.md. Frontend (public) variables live in web/.env.example.

# ===========================================================================
# OpenAI research agent
# ===========================================================================
# The API key. STRIX accepts either variable name; OPEN_AI_API_KEY is the
# project's historical name and OPENAI_API_KEY is what the OpenAI SDK expects.
OPENAI_API_KEY=sk-your-openai-key-here
# OPEN_AI_API_KEY=sk-your-openai-key-here

# Provider + model. gpt-6-luna is the default because it is the cheapest of the
# permitted models (gpt-6-luna, gpt-6.1-terra, gpt-6.1-sol, gpt-6-astra).
STRIX_LLM_PROVIDER=openai
STRIX_LLM_MODEL=gpt-6-luna
STRIX_LLM_REASONING_EFFORT=low
STRIX_LLM_MAX_OUTPUT_TOKENS=4096
STRIX_LLM_REQUEST_TIMEOUT_SECONDS=60
STRIX_LLM_MAX_RETRIES=2

# Per-run research budget (all enforced in code). The $0.05 cap is a hard ceiling.
STRIX_AGENT_MAX_MODEL_CALLS=8
STRIX_AGENT_MAX_TOOL_CALLS=16
STRIX_AGENT_MAX_RESEARCH_SECONDS=120
STRIX_AGENT_MAX_INPUT_TOKENS=100000
STRIX_AGENT_MAX_TOTAL_OUTPUT_TOKENS=16000
STRIX_AGENT_MAX_COST_USD=0.05

STRIX_AGENT_ALLOW_MODEL_ESCALATION=false
STRIX_AGENT_REQUIRE_VERIFIED_CLAIMS=true
STRIX_AGENT_REQUIRE_CITATIONS=true
STRIX_OPENAI_WEB_SEARCH_ENABLED=true

# ===========================================================================
# Market / economic data providers
# ===========================================================================
# Alpaca (equities market data). Optional; tools degrade gracefully if absent.
# ALPACA_API_KEY_ID=your-alpaca-key-id
# ALPACA_API_SECRET_KEY=your-alpaca-secret

# SEC EDGAR requires a descriptive User-Agent for identification.
# SEC_EDGAR_USER_AGENT=STRIX Research (contact@example.com)

# FRED (Federal Reserve economic data). Optional.
# FRED_API_KEY=your-fred-api-key

# ===========================================================================
# Supabase — persistence + authentication (hosted deployment)
# ===========================================================================
# Project URL (also used to derive the Auth JWKS endpoint for token verification).
SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable / anon key (public-safe; mirrored to the frontend as VITE_SUPABASE_ANON_KEY).
SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
# Service-role key — SERVER-SIDE ONLY. Used for evidence storage uploads. NEVER
# expose in the browser or a VITE_ variable.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Legacy HS256 JWT secret — ONLY if your project still uses symmetric signing.
# New projects use asymmetric JWKS (verified via SUPABASE_URL) and need nothing here.
# SUPABASE_JWT_SECRET=your-legacy-jwt-secret

# ===========================================================================
# Server-side database (durable job store)
# ===========================================================================
# PostgreSQL connection string to the Supabase Supavisor transaction pooler
# (the serverless-friendly endpoint, port 6543). SERVER-SIDE ONLY.
# STRIX_DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Backend selection: 'supabase' | 'local'. Auto-detected (supabase if a DB URL
# is set, else the local SQLite store for offline development).
# STRIX_PERSISTENCE_BACKEND=supabase
# Local SQLite job-store path (offline/dev only).
# STRIX_JOBS_DB=research_runs/jobs.db

# ===========================================================================
# Private evidence / replay object storage (Supabase Storage)
# ===========================================================================
STRIX_EVIDENCE_BUCKET=strix-evidence
# Ephemeral scratch for a run's artifacts during one invocation (Vercel: /tmp).
# STRIX_STATE_DIR=/tmp/strix-runs

# ===========================================================================
# Durable execution, triggers, and recovery
# ===========================================================================
# Shared secret guarding the internal /api/jobs/execute route (self-invocation).
# STRIX_INTERNAL_SECRET=generate-a-long-random-string
# Vercel sets this automatically for cron auth on /api/jobs/sweep.
# CRON_SECRET=generate-a-long-random-string
# Base URL for fire-and-forget self-invocation (defaults to https://$VERCEL_URL).
# STRIX_SELF_BASE_URL=https://your-deployment.vercel.app
# Execution lease + absolute deadline windows (must exceed MAX_RESEARCH_SECONDS).
# STRIX_LEASE_SECONDS=180
# STRIX_DEADLINE_SECONDS=240
# STRIX_MAX_JOB_ATTEMPTS=2

# ===========================================================================
# Access control, rate limiting, and spend caps
# ===========================================================================
# STRIX_RATE_LIMIT_PER_MINUTE=10
# STRIX_MAX_CONCURRENT_JOBS_PER_USER=3
# STRIX_USER_DAILY_COST_USD=1.00
# STRIX_GLOBAL_DAILY_COST_USD=25.00
# Extra allowed CORS origins (comma-separated). Production is same-origin → leave empty.
# STRIX_ALLOWED_ORIGINS=
# Offline-dev auth bypass. NEVER set to 'dev' in production.
# STRIX_AUTH_MODE=dev

# ===========================================================================
# Optional: Snowflake analytical warehouse (data engineering; not on Vercel)
# ===========================================================================
# SNOWFLAKE_ACCOUNT=your-account
# SNOWFLAKE_USER=your-user
# SNOWFLAKE_PASSWORD=your-password
# SNOWFLAKE_WAREHOUSE=your-warehouse
# SNOWFLAKE_DATABASE=your-database
# SNOWFLAKE_SCHEMA=your-schema

# ===========================================================================
# Optional: external cloud worker (for workloads beyond serverless limits)
# ===========================================================================
# STRIX_WORKER_URL=https://your-worker-host.example.com
# STRIX_WORKER_SECRET=generate-a-long-random-string
